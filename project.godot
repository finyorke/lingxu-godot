; Engine configuration file.
; Best edited using the editor UI; kept explicit here for reproducible web export.
config_version=5

[application]
config/name="御剑灵墟"
config/description="2D xianxia survivor roguelite web preview."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.132812, 0.199219, 0.179688, 1)

[autoload]
SignalsBus="*res://Scripts/autoload/SignalsBus.gd"
ConfigDB="*res://Scripts/autoload/ConfigDB.gd"
AssetDB="*res://Scripts/autoload/AssetDB.gd"
GameState="*res://Scripts/autoload/GameState.gd"
SaveSystem="*res://Scripts/autoload/SaveSystem.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[gui]
theme/custom="res://assets/ui/DefaultTheme.tres"

